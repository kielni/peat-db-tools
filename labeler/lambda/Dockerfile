FROM public.ecr.aws/lambda/python:3.12
COPY --from=ghcr.io/astral-sh/uv:0.11.11 /uv /bin/uv

# requirements.txt is exported from uv.lock by `make build`
COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN uv pip install --no-cache --target ${LAMBDA_TASK_ROOT} \
    -r ${LAMBDA_TASK_ROOT}/requirements.txt

# keys.json is generated by `make keys`; service-account.json is copied by `make build`
COPY app.py keys.json service-account.json ${LAMBDA_TASK_ROOT}/

CMD ["app.handler"]
