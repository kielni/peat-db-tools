# Copy to local.env and fill in. Make reads this file directly:
# no quotes and no spaces around "=".

AWS_REGION=us-west-2

FUNCTION_NAME=peat-labels

ECR_REPO=peat-labels

# Bucket names are global; pick a unique one
SITE_BUCKET=peat-labels-site-CHANGE-ME

# S3 website address, no trailing slash. Older regions (us-east-1, us-west-2, ...)
# use "s3-website-REGION"; newer ones use "s3-website.REGION".
SITE_URL=http://peat-labels-site-CHANGE-ME.s3-website-us-west-2.amazonaws.com

# From the sheet's URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
SHEET_ID=

MAPTILER_API_KEY=

# Lambda function URL: Lambda console > Functions > FUNCTION_NAME > Function URL
API_URL=

# load map with this key to show all observations
SHOW_ALL_KEY=
