# Copy to local.env and fill in. Make reads this file directly:
# no quotes and no spaces around "=".

AWS_REGION=us-west-2

# Bucket names are global; pick a unique one
SITE_BUCKET=peat-db-map-CHANGE-ME
# derived from SITE_BUCKET and AWS_REGION; no trailing slash
SITE_URL=https://${SITE_BUCKET}.s3.${AWS_REGION}.amazonaws.com

MAPTILER_API_KEY=
